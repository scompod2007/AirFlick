<Window
    x:Class="AirFlick.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AirFlick"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AirFlick v2.0.1 (Final Gesture Engine)">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Branding -->
        <Border Grid.Row="0" Padding="24,18,24,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B9;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="AirFlick" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="v2.0.1 (Final Gestures: GRAB / DROP / PIN1-5 / CONFIRM)" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Fast, offline-first Wi-Fi Direct file sharing with 3-digit PIN authentication." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Discovery Controls & Live Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{x:Bind ViewModel.StartDiscoveryCommand}" ToolTipService.ToolTip="Scan for nearby AirFlick laptops">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="14"/>
                            <TextBlock Text="Scan"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.StopDiscoveryCommand}" ToolTipService.ToolTip="Stop scanning">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Gesture HUD Panel & Feedback Notifications -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="24,12,24,0">
            <!-- Dedicated Physical Camera & Gesture Status Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Real Camera Status & Toggle Button -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Truthful Camera State & Details -->
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE714;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Physical Webcam Pipeline:" FontWeight="SemiBold" FontSize="13"/>

                                <!-- Status Badge -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind ViewModel.CameraStatusMessage, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.CameraDetails, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.IsCameraActive, Mode=OneWay}">
                                    <TextBlock Text="Captured Frames:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CameraFrameCount, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Real Camera Action Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OnToggleGestureCameraClicked" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Start or stop the physical webcam gesture tracking process">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE714;" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ViewModel.CameraToggleButtonText, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Gesture Detection Readout & Test/Simulation Controls -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Gesture Recognition State -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Last Detected Gesture:" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{x:Bind ViewModel.LastDetectedGesture, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SimulationModeNotice, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Manual Simulation Fallback for testing without camera -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Test Simulation:" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Command="{x:Bind ViewModel.SimulateGrabCommand}" ToolTipService.ToolTip="Simulate Fist GRAB: Prepares file share &amp; starts discovery" Padding="8,4">
                                    <TextBlock Text="✊ GRAB" FontSize="11"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.SimulateDropCommand}" ToolTipService.ToolTip="Simulate Thumb-Down DROP: Commits share &amp; auto-selects receiver" Padding="8,4">
                                    <TextBlock Text="👎 DROP" FontSize="11"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.SimulateConfirmCommand}" ToolTipService.ToolTip="Simulate Thumbs-Up CONFIRM: Confirms &amp; receives file" Padding="8,4">
                                    <TextBlock Text="👍 CONFIRM" FontSize="11"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Click="OnSimulatePinClicked" Tag="1" Content="1" Padding="5,2" FontSize="11" ToolTipService.ToolTip="Simulate PIN 1"/>
                                    <Button Click="OnSimulatePinClicked" Tag="2" Content="2" Padding="5,2" FontSize="11" ToolTipService.ToolTip="Simulate PIN 2"/>
                                    <Button Click="OnSimulatePinClicked" Tag="3" Content="3" Padding="5,2" FontSize="11" ToolTipService.ToolTip="Simulate PIN 3"/>
                                    <Button Click="OnSimulatePinClicked" Tag="4" Content="4" Padding="5,2" FontSize="11" ToolTipService.ToolTip="Simulate PIN 4"/>
                                    <Button Click="OnSimulatePinClicked" Tag="5" Content="5" Padding="5,2" FontSize="11" ToolTipService.ToolTip="Simulate PIN 5"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Camera Unavailable Privacy Helper Notice -->
            <InfoBar IsOpen="{x:Bind ViewModel.IsCameraUnavailable, Mode=OneWay}"
                     Severity="Warning"
                     Title="Physical Camera Notice"
                     Message="The physical webcam could not be activated. If your laptop webcam does not start, ensure Windows camera permissions are allowed (Settings > Privacy &amp; security > Camera > 'Let desktop apps access your camera' = ON), and that no other application (Zoom, Teams) is using the webcam."
                     IsClosable="False"/>

            <!-- Feedback & Notifications Bar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"
                     Closed="OnErrorInfoBarClose"/>

            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                     Severity="Success"
                     Title="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                     IsClosable="True"
                     Closed="OnSuccessInfoBarClose"/>
        </StackPanel>

        <!-- Main Content Area: Sender & Receiver Columns -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: SENDER WORKFLOW ================= -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Send a File" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Choose a file to share. AirFlick will make your device discoverable and generate a secure 3-digit PIN." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                        <!-- Step 1: File Selection -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" HorizontalAlignment="Stretch" Click="OnPickFileClicked" Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                        <TextBlock Text="Select File from PC..."/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedFileName, Mode=OneWay}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedFileSizeText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Step 2: Prepare Share & PIN generation -->
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.PrepareShareCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                <TextBlock Text="Create Share Ticket &amp; Show PIN (or ✊ GRAB)"/>
                            </StackPanel>
                        </Button>

                        <!-- Pending Share PIN Card -->
                        <Border Visibility="{x:Bind ViewModel.PendingShareVisibility, Mode=OneWay}"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="SHARE AUTHORIZATION PIN" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.PendingSharePin, Mode=OneWay}" FontSize="36" FontWeight="Bold" CharacterSpacing="200" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Share this 3-digit PIN with the receiver" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xED5A;" FontSize="12"/>
                                    <TextBlock Text="Expires in: " Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.PinSecondsRemaining, Mode=OneWay}" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="s" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Command="{x:Bind ViewModel.CancelShareCommand}" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.PendingShareVisibility, Mode=OneWay}">
                            <TextBlock Text="Cancel Pending Share"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ================= RIGHT COLUMN: RECEIVER WORKFLOW ================= -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Receive a File" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Select a nearby sender from discovered Wi-Fi Direct devices, enter the PIN shown on their screen, and receive the file." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                        <!-- Step 1: Nearby Senders List -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE753;" FontSize="14"/>
                                    <TextBlock Text="Nearby Devices (or 👎 DROP to Auto-Select)" FontWeight="Medium"/>
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSenderDevice, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          Height="130"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="16"/>
                                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="No devices discovered yet. Click 'Scan' above if needed." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind ViewModel.NoDevicesDiscoveredVisibility, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: 3-Digit PIN Input -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Enter Sender's 3-Digit PIN (Digits 1-5)" FontWeight="Medium"/>
                                <TextBox Text="{x:Bind ViewModel.ReceiverPinInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="3"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         PlaceholderText="123"
                                         InputScope="Number"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: Receive Action -->
                        <Button Command="{x:Bind ViewModel.ReceiveFileCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                <TextBlock Text="Connect &amp; Receive File (or 👍 CONFIRM)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Footer: Transfer Progress & Backend Status -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="Medium" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveTransferFileName, Mode=OneWay}" FontWeight="Bold" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Real Transfer Progress Bar -->
                    <Grid Visibility="{x:Bind ViewModel.TransferActiveVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{x:Bind ViewModel.TransferProgress, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransferProgressText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="1" Command="{x:Bind ViewModel.CancelShareCommand}" Visibility="{x:Bind ViewModel.TransferActiveVisibility, Mode=OneWay}" Style="{ThemeResource DefaultButtonStyle}" VerticalAlignment="Center">
                    <TextBlock Text="Cancel Transfer"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
